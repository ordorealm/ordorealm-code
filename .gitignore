# Dependencies
node_modules/

# Build output
out/
dist/
release/

# TypeScript incremental build cache
*.tsbuildinfo

# macOS system files
.DS_Store

# Logs
*.log
npm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

# pnpm lock (use package-lock.json instead)
# pnpm-lock.yaml

# Superspec temporary files
.superspec/state.json.tmp
.superspec/.needs-review
.superspec/.timeout

# Runtime binaries (downloaded via npm run download-runtime)
# Keep directory structure but ignore binaries
electron/runtime/node/win-x64/*
electron/runtime/node/darwin-x64/*
electron/runtime/node/darwin-arm64/*
electron/runtime/git/win-x64/*
!electron/runtime/node/win-x64/.gitkeep
!electron/runtime/node/darwin-x64/.gitkeep
!electron/runtime/node/darwin-arm64/.gitkeep
!electron/runtime/git/win-x64/.gitkeep

# Debug/test files
test-*.js
