{
  "version": "1.0.0",
  "project": {
    "type": "desktop",
    "name": "devflow-ide",
    "mode": "existing",
    "framework": {
      "frontend": "react",
      "backend": null,
      "desktop": "electron"
    }
  },
  "frontend": {
    "framework": "react",
    "port": 5173,
    "startCommand": "npm run dev",
    "buildCommand": "npm run build",
    "testCommand": "npm run test",
    "healthCheck": "http://localhost:5173"
  },
  "backend": null,
  "database": null,
  "desktop": {
    "framework": "electron",
    "startCommand": "npm run dev",
    "buildCommand": "npm run build",
    "buildMac": "npm run build:mac",
    "buildWin": "npm run build:win",
    "testCommand": "npm run test"
  },
  "dependencies": {
    "required": {
      "git": ">=2.0",
      "node": ">=18.0",
      "npm": ">=9.0"
    },
    "optional": {
      "pnpm": ">=8.0"
    }
  },
  "envVars": {
    "required": [],
    "optional": []
  },
  "testStrategy": {
    "e2e": true,
    "unit": true,
    "visual": true,
    "a11y": false,
    "api": false,
    "cli": false
  }
}
