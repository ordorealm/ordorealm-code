{
  "name": "devflow-ide",
  "version": "0.0.1",
  "description": "A developer workflow IDE built with Electron and React",
  "main": "./out/main/index.js",
  "author": "devflow-ide",
  "homepage": "https://github.com/devflow-ide/devflow-ide",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "start": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "download-runtime": "npx tsx electron/builder/runtime-downloader.ts",
    "download-runtime:win": "npx tsx electron/builder/runtime-downloader.ts --platform win --arch x64",
    "download-runtime:mac": "npx tsx electron/builder/runtime-downloader.ts --platform darwin",
    "install-native-all": "npm install --force --no-save @anthropic-ai/claude-agent-sdk-darwin-x64 @anthropic-ai/claude-agent-sdk-darwin-arm64 @anthropic-ai/claude-code-darwin-x64 @anthropic-ai/claude-code-darwin-arm64 @anthropic-ai/claude-agent-sdk-win32-x64 @anthropic-ai/claude-code-win32-x64",
    "prebuild:mac": "npm run download-runtime:mac && npm run install-native-all",
    "prebuild:win": "npm run download-runtime:win && npm run install-native-all",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.144",
    "@anthropic-ai/claude-code": "^2.1.144",
    "@monaco-editor/react": "^4.7.0",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.5.17",
    "chokidar": "^5.0.0",
    "crypto-js": "^4.2.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar": "^7.4.3",
    "uuid": "^14.0.0",
    "weclaw": "^0.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^10.3.0",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.14",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
